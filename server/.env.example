PORT=5000
# Comma-separated origins allowed to call the API when the frontend is hosted elsewhere.
# Leave empty if the server serves the page itself (same origin).
CORS_ORIGINS=
# Set to "false" to run API-only (frontend on static hosting)
SERVE_CLIENT=true
MAX_FILE_MB=50
JOB_TIMEOUT_SEC=120
MAX_CONCURRENT_JOBS=2
MAX_PAGES_OCR=50
RATE_LIMIT_MAX=60
# TMP_ROOT=C:\badpdf-tmp
# Optional explicit paths to native tools (needed on Windows if they are not on PATH):
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# QPDF_PATH=C:\Tools\qpdf\bin\qpdf.exe
# GS_PATH=C:\Program Files\gs\gs10.03.1\bin\gswin64c.exe
# PDFTOTEXT_PATH=C:\Tools\poppler\Library\bin\pdftotext.exe
# PDFTOPPM_PATH=C:\Tools\poppler\Library\bin\pdftoppm.exe
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
